# grok-search-rs configuration reference
#
# This file is a reference only. Actual configuration lives in .mcp.json.
# Edit the "env" block in .mcp.json to set your keys and preferences.
# See docs/CONFIGURATION.md for full documentation on each variable.

# ── Grok / xAI ───────────────────────────────────────
# GROK_SEARCH_AUTH_MODE=api_key          # api_key | oauth
# GROK_SEARCH_API_KEY=your-grok-key
# GROK_SEARCH_URL=https://api.x.ai
# GROK_SEARCH_MODEL=grok-4-1-fast-reasoning
# GROK_SEARCH_WEB_SEARCH=true
# GROK_SEARCH_X_SEARCH=false
# GROK_SEARCH_AUTH_FILE=                 # OAuth token path override

# ── Tavily ───────────────────────────────────────────
# TAVILY_API_KEY=tvly-your-key
# TAVILY_API_URL=https://api.tavily.com
# TAVILY_ENABLED=true

# ── Firecrawl ────────────────────────────────────────
# FIRECRAWL_API_KEY=fc-your-key
# FIRECRAWL_API_URL=https://api.firecrawl.dev
# FIRECRAWL_ENABLED=true

# ── OpenAI-compatible transport ──────────────────────
# OPENAI_COMPATIBLE_API_URL=https://your-gateway/v1
# OPENAI_COMPATIBLE_API_KEY=sk-...
# OPENAI_COMPATIBLE_MODEL=grok-4.3-fast

# ── Behavior tuning ──────────────────────────────────
# GROK_SEARCH_EXTRA_SOURCES=3
# GROK_SEARCH_FALLBACK_SOURCES=5
# GROK_SEARCH_FETCH_MAX_CHARS=
# GROK_SEARCH_CACHE_SIZE=256
# GROK_SEARCH_TIMEOUT_SECONDS=60
# GITHUB_TOKEN=ghp_...
# GROK_SEARCH_SOURCE_MAX_ANSWERS=5
# GROK_SEARCH_SOURCE_MAX_COMMENTS=30
# GROK_SEARCH_ENRICH_CONCURRENCY=3
# GROK_SEARCH_ENRICH_MAX_CHARS=15000
